{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "OpenTelemetry": {
      "IncludeFormattedMessage": true,
      "IncludeScopes": true,
      "ParseStateValues": true
    }
  },
  "AllowedHosts": "*",
  "AzureOpenAI": {
    "Endpoint": "https://movie-tracker-openai.openai.azure.com/",
    "ApiKey": "<set-in-env>",
    "DeploymentName": "gpt-5-4-mini"
  },
  "TheMovieDb": {
    "Api-Key": "<set-in-env>"
  },
  "Cosmos": {
    "Database": "database",
    "Container": "chat-sessions"
  }
}
