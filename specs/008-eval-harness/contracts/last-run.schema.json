{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://movie-tracker-api/specs/008-eval-harness/last-run.schema.json",
  "title": "RunResult",
  "description": "Documentation-only. Shape of MovieTracker.Evals/results/last-run.json. The harness does NOT validate this file against the schema at run time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runAt", "total", "passed", "perCheck", "cases"],
  "properties": {
    "runAt": {
      "type": "string",
      "format": "date-time"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Produced-case count. Typically 10 (2 anchors + 8 templated); smaller only when the trailer template did not qualify (no case produced). FR-016 'no truth value' cases still appear in the table as FAIL and still count toward the total."
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "perCheck": {
      "type": "array",
      "items": { "$ref": "#/$defs/perCheckCount" }
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/caseResult" }
    }
  },
  "$defs": {
    "checkKind": {
      "type": "string",
      "enum": [
        "listIncludes",
        "director",
        "actorFilmography",
        "identifyByPlot",
        "genreDecade",
        "rating",
        "trailer",
        "followUpDirector",
        "funnyFactNotEmpty"
      ]
    },
    "perCheckCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "passed", "total"],
      "properties": {
        "check": { "$ref": "#/$defs/checkKind" },
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check", "passed", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Plot-anchor id or '<templateId>-<slot>' for generated cases (slot is 1..3)."
        },
        "check": { "$ref": "#/$defs/checkKind" },
        "passed": { "type": "boolean" },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
